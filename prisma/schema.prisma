generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  phone        String  @unique
  passwordHash String?

  firstName String?
  lastName  String?
  email     String?

  role UserRole @default(PLAYER)

  // Bumped to invalidate every outstanding session JWT for this user.
  sessionVersion Int       @default(0)
  // Set when the account is deleted; personal fields are anonymised at the same time.
  deletedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations          Location[]
  bookings           Booking[]
  address            UserAddress?
  wallet             Wallet?
  withdrawalRequests WithdrawalRequest[]
  staffLocations     LocationStaff[]
  reviews            Review[]
  favorites          Favorite[]
  notifications      Notification[]
  auditLogs          AuditLog[]
}

model Sport {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilities Facility[]
}

model Location {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  address     String
  city        String
  description String?
  phone       String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner          User            @relation(fields: [ownerId], references: [id])
  facilities     Facility[]
  availabilities Availability[]
  blockedDates   BlockedDate[]
  pricingRules   PricingRule[]
  staff          LocationStaff[]
  images         LocationImage[]
  reviews        Review[]
  favorites      Favorite[]

  @@index([ownerId])
  @@index([city])
}

model Facility {
  id          String   @id @default(cuid())
  locationId  String
  name        String
  description String?
  imageUrl    String?
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location        @relation(fields: [locationId], references: [id])
  sports   Sport[]
  bookings Booking[]
  images   FacilityImage[]
  reviews  Review[]

  @@index([locationId])
}

model Availability {
  id               String   @id @default(cuid())
  locationId       String
  dayOfWeek        Int
  startTime        String
  endTime          String
  isActive         Boolean  @default(true)
  isTwentyFourHour Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, dayOfWeek])
  @@index([locationId])
}

model BlockedDate {
  id         String   @id @default(cuid())
  locationId String
  date       DateTime
  reason     String?
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, date])
  @@index([locationId])
  @@index([date])
}

model PricingRule {
  id         String   @id @default(cuid())
  locationId String
  name       String?
  startTime  String
  endTime    String
  percentage Float
  dayOfWeek  Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model Booking {
  id         String   @id @default(cuid())
  playerId   String
  facilityId String
  startAt    DateTime
  endAt      DateTime
  totalPrice Decimal  @db.Decimal(10, 2)

  status BookingStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?
  paymentMethod String?
  orderId       String?       @unique
  // Shared PayHere order id when several bookings (a recurring series) are paid together.
  groupOrderId  String?
  expiresAt     DateTime?

  // Owner's share of totalPrice (price after pricing rules, before platform fee).
  ownerAmount Decimal? @db.Decimal(10, 2)

  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?

  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player   User     @relation(fields: [playerId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])
  review   Review?

  // Overlap protection lives in the migration as an exclusion constraint
  // ("Booking_no_overlap"), which Prisma cannot express in the schema.
  @@index([playerId])
  @@index([groupOrderId])
  @@index([facilityId])
  @@index([startAt, endAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([expiresAt])
}

enum UserRole {
  PLAYER
  OWNER
  ADMIN
  STAFF
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  CHARGEBACK
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
}

model UserAddress {
  id           String  @id @default(cuid())
  userId       String  @unique
  addressLine1 String
  addressLine2 String?
  city         String
  country      String  @default("Sri Lanka")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id      String  @id @default(cuid())
  userId  String  @unique
  balance Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WithdrawalRequest {
  id                String           @id @default(cuid())
  ownerId           String
  amount            Decimal          @db.Decimal(10, 2)
  bankName          String
  // AES-256-GCM ciphertext (see src/lib/crypto.ts); legacy rows may still be plaintext.
  accountNumber     String
  accountLast4      String?
  accountHolderName String
  status            WithdrawalStatus @default(PENDING)
  adminNote         String?
  // True when the amount was held (debited) from the wallet at request time.
  walletDebited     Boolean          @default(false)
  processedById     String?
  processedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  owner User @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@index([status])
}

model LocationStaff {
  id         String   @id @default(cuid())
  locationId String
  staffId    String
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff    User     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([locationId, staffId])
  @@index([locationId])
  @@index([staffId])
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model WalletTransaction {
  id                  String                    @id @default(cuid())
  walletId            String
  amount              Decimal                   @db.Decimal(10, 2)
  type                WalletTransactionType
  category            WalletTransactionCategory @default(ADJUSTMENT)
  // Wallet balance immediately after this transaction was applied.
  balanceAfter        Decimal?                  @db.Decimal(10, 2)
  bookingId           String?
  withdrawalRequestId String?
  note                String?

  createdAt DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([bookingId])
  @@index([withdrawalRequestId])
}

enum WalletTransactionCategory {
  BOOKING_PAYMENT
  BOOKING_REFUND
  BOOKING_EARNING
  EARNING_REVERSAL
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  ADJUSTMENT
}

model FacilityImage {
  id         String   @id @default(cuid())
  facilityId String
  url        String
  publicId   String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
}

model LocationImage {
  id         String   @id @default(cuid())
  locationId String
  url        String
  publicId   String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  playerId   String
  locationId String
  facilityId String
  rating     Int
  comment    String?
  ownerReply String?
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  player   User     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([facilityId])
  @@index([playerId])
}

model Favorite {
  userId     String
  locationId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([locationId])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  channel   NotificationChannel
  type      String
  recipient String
  subject   String?
  body      String
  status    NotificationStatus  @default(PENDING)
  error     String?
  bookingId String?
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId, type])
  @@index([createdAt])
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// Fixed-window rate limit counters, keyed by e.g. "send-otp:phone:94771234567".
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}
