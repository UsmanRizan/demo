# Copy to .env and fill in. Never commit real values.

# PostgreSQL connection string
DATABASE_URL=

# Signs session JWTs. Long random string.
SESSION_SECRET=

# Encrypts bank account numbers at rest: 32 bytes as 64 hex chars.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it once data exists, or old values become unreadable.
DATA_ENCRYPTION_KEY=

# Public base URL, e.g. https://bookmyplay.lk (used for PayHere callbacks, SEO, emails)
APP_URL=http://localhost:3000

# Text.lk SMS (OTP, confirmations, reminders)
TEXTLK_API_TOKEN=
TEXTLK_SENDER_ID=

# PayHere
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox

# Cloudinary (facility and venue photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bearer token for /api/cron. Call it every 5-10 minutes.
CRON_SECRET=

# Optional: transactional email through Resend
RESEND_API_KEY=
EMAIL_FROM="BookMyPlay <no-reply@example.com>"
# Optional: contact form messages are emailed here
SUPPORT_EMAIL=

# Optional: error tracking
SENTRY_DSN=

# Development only
# NOTIFICATIONS_DRY_RUN=true   # record notifications without sending SMS/email
# OTP_DEV_LOG=true             # print OTP codes to the server console instead of SMS
